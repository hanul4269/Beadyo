#!/bin/sh
set -eu

status=0

while read local_ref local_sha remote_ref remote_sha
do
    case "$local_sha" in
        0000000000000000000000000000000000000000)
            continue
            ;;
    esac

    case "$remote_ref" in
        refs/heads/main)
            if ! node scripts/check-patch-note.js --ref "$local_sha"
            then
                echo "pre-push: patch-notes.json에 오늘 패치노트가 없어 main 푸시를 중단합니다." >&2
                echo "pre-push: node scripts/add-patch-note.js --tag 관리 --item \"변경 내용\" 실행 후 다시 커밋하세요." >&2
                status=1
            fi
            ;;
    esac
done

exit "$status"
