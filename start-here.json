  "terms": [
    {
      "term": "구북이",
      "meaning": "구슬요의 팬을 부르는 이름이자 팬 캐릭터의 이름이에요."
    },
    {
      "term": "구북티콘",
      "meaning": "팬 캐릭터 구북이의 다양한 표정과 동작을 담은 이모티콘이에요."
    },
    {
      "term": "마마마",
      "meaning": "말을 이어가거나 무언가를 떠올릴 때 사용하는 추임새예요."
    },
    {
      "term": "띵가뽕",
      "meaning": "넘기거나 빼먹었다는 뜻으로 쓰는 방송 속 표현이에요."
    },
    {
      "term": "슬이봤?",
      "meaning": "‘슬요야 이거 봤어?’의 줄임말. 시청자가 올린 영상과 이야기를 함께 보는 콘텐츠예요."
    },
    {
      "term": "지몸지챙",
      "meaning": "‘자기 몸은 자기가 챙겨라’라는 뜻으로 서로의 건강을 챙기는 표현이에요."
    },
    {
      "term": "똥확찢",
      "meaning": "‘똥꼬를 확 찢어버린다’의 줄임말로, 구북이와 티키타카할 때 쓰는 장난스러운 표현이에요."
    },
    {
      "term": "꼭 이루래이",
      "meaning": "뜻하는 바 꼭 이루라는 응원과 농담을 담은 말이에요. 채팅에서는 ‘ㄲㅇㄹㄹㅇ’로도 써요."
    },
    {
      "term": "감나무",
      "meaning": "로나월드에서 생긴 애칭으로, ‘감나무에서 떨어진 바보’라는 방송 속 농담에서 나왔어요."
    },
    {
      "term": "계산요",
      "meaning": "개모임이 출연한 진실게임에서, 일할 때 이성적으로 판단하고 계산하는 모습을 두고 생긴 별명이에요."
    },
    {
      "term": "구스르자브종",
      "meaning": "냐냐·엘시·바밍·따린과 함께하는 개모임에서 쓰는 구슬요의 별명이에요."
    },
    {
      "term": "무랄요",
      "meaning": "봉준의 콘텐츠에서 쓰는 구슬요의 별명으로, 무랄시대 활동에서도 사용했어요."
    },
    {
      "term": "만개요",
      "meaning": "무랄시대 월드 투어에서 별풍선 분배액으로 1만 개를 말했던 방송 속 장면에서 생긴 별명이에요."
    }
  ],
